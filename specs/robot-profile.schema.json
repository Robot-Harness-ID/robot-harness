{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robot-harness:robot-profile:0.1.0",
  "title": "RobotProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "robot",
    "frames",
    "control",
    "observations",
    "calibrations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "model",
        "urdf_sha256"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "firmware": {
          "type": ["string", "null"]
        },
        "tool": {
          "type": ["string", "null"]
        },
        "urdf_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "tcp",
        "transform_convention",
        "transforms"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1
        },
        "tcp": {
          "type": "string",
          "minLength": 1
        },
        "transform_convention": {
          "const": "T_parent_child transforms coordinates from child to parent"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transform"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "angle_unit",
        "length_unit",
        "single_writer",
        "command_timeout_ms",
        "independent_estop"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["position", "velocity", "effort", "trajectory", "other"]
          }
        },
        "angle_unit": {
          "const": "rad"
        },
        "length_unit": {
          "const": "m"
        },
        "single_writer": {
          "type": "boolean"
        },
        "command_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "maximum_speed_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "independent_estop": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "timestamp_source",
          "stale_after_ms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "frame_id": {
            "type": ["string", "null"]
          },
          "timestamp_source": {
            "type": "string",
            "minLength": 1
          },
          "stale_after_ms": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "calibrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "status",
          "fit_sample_count",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["fitted", "validated", "stale", "invalid"]
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "fit_sample_count": {
            "type": "integer",
            "minimum": 1
          },
          "validation": {
            "$ref": "#/$defs/validation"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "child",
        "matrix_row_major",
        "source",
        "status"
      ],
      "properties": {
        "parent": {
          "type": "string",
          "minLength": 1
        },
        "child": {
          "type": "string",
          "minLength": 1
        },
        "matrix_row_major": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "number"
          }
        },
        "source": {
          "enum": ["nominal", "measured", "estimated", "unknown"]
        },
        "status": {
          "enum": ["unvalidated", "valid", "stale", "invalid"]
        },
        "calibration_id": {
          "type": ["string", "null"]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "independent",
        "sample_count",
        "metrics"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "independent": {
          "type": "boolean"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
